// =========================================================================
// secrets.h.example - Template for Hardware & Network Credentials
// Firmware: 06_standalone_tapo_streamer
// Copy this file to secrets.h and populate with your credentials.
// =========================================================================

#ifndef SECRETS_H
#define SECRETS_H

// Wi-Fi Access Point Credentials
const char* WIFI_SSID = "YOUR_WIFI_SSID";
const char* WIFI_PASS = "YOUR_WIFI_PASSWORD";

// Firebase Realtime Database
const char* FIREBASE_HOST = "https://YOUR_PROJECT_ID-default-rtdb.firebasedatabase.app";
const char* FIREBASE_AUTH = "YOUR_FIREBASE_DATABASE_SECRET";

// TP-Link Tapo P110 Smart Socket Local Configuration (KLAP Protocol)
// Obtain from Tapo App -> Device Info (IP) and Me -> Third-Party / Advanced -> Device Account
const char* TAPO_IP   = "192.168.0.XX";   // Set to your Tapo P110 LAN IP
const char* TAPO_USER = "admin";          // Tapo local Device Account username
const char* TAPO_PASS = "YOUR_PASSWORD";  // Tapo local Device Account password

#endif // SECRETS_H
