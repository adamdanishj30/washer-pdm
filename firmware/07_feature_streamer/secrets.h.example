// =========================================================================
// secrets.h.example - credentials template for firmware 07
// Copy to secrets.h (same folder) or let flash_firmware.py generate it from
// the project .env file. secrets.h must NEVER be shared or committed.
// =========================================================================
#ifndef SECRETS_H
#define SECRETS_H

// --- Wi-Fi (2.4 GHz) ---
const char* WIFI_SSID = "YOUR_WIFI_SSID";
const char* WIFI_PASS = "YOUR_WIFI_PASSWORD";

// --- Firebase Realtime Database ---
// Host WITHOUT trailing slash, e.g. https://<project>-default-rtdb.asia-southeast1.firebasedatabase.app
const char* FIREBASE_HOST = "https://YOUR_PROJECT-default-rtdb.REGION.firebasedatabase.app";
// Database secret (Project settings -> Service accounts -> Database secrets).
// Rotate it if it has ever been stored in a synced/shared folder.
const char* FIREBASE_AUTH = "YOUR_DATABASE_SECRET";

// --- Tapo P110 local Device Account (only used when USE_TAPO = 1) ---
const char* TAPO_IP   = "192.168.0.XX";
const char* TAPO_USER = "your-tapo-account-email";
const char* TAPO_PASS = "your-tapo-account-password";

// --- Optional: password for wireless (OTA) flashing. Strongly recommended.
// #define OTA_PASS "choose-a-long-random-password"

#endif // SECRETS_H
